# Copy this file to .env.local and fill in values from your Supabase project:
#   Supabase Dashboard > Project Settings > API
# .env.local is gitignored.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# .NET backend (Project02-be). See ../Project02-be/INTEGRATION_ROADMAP.md.
# NEXT_PUBLIC_API_MODE: "supabase" (default) | "dotnet" — global backend switch;
# per-resource overrides live in src/lib/data/mode.ts.
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_API_MODE=dotnet
# NEXT_PUBLIC_AUTH_MODE: "supabase" (default) | "dotnet" — auth cutover (Phase 1)
NEXT_PUBLIC_AUTH_MODE=dotnet
