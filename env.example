# Copy this file to .env.local. The app talks only to the .NET backend
# (Project02-be); .env.local is gitignored.

# .NET backend (Project02-be).
NEXT_PUBLIC_API_URL=http://localhost:5000

# The migration verification scripts under scripts/parity/ and scripts/dev/
# still read the old Supabase project directly. Only those Node scripts need
# these — the app bundle does not. Leave unset unless you run them.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
