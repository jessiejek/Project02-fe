# Copy this file to .env.local. The app talks only to the .NET backend
# (Project02-be); .env.local is gitignored.

# .NET backend (Project02-be).
NEXT_PUBLIC_API_URL=http://localhost:5000

# The migration verification scripts under scripts/parity/ and scripts/dev/
# still read the old Supabase project directly. Only those Node scripts need
# these — the app bundle does not. Leave unset unless you run them.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared with Project02-be Jwt:Secret / Issuer / Audience (server-only).
# Required for proxy + session role gating. Never prefix with NEXT_PUBLIC_.
# Local default must match Project02-be appsettings.Development.json Jwt:Secret.
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789abcdef
JWT_ISSUER=ClinicApp
JWT_AUDIENCE=ClinicApp
